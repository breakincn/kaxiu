# Kabao runtime environment example

# Core environment
KABAO_ENV=production
KABAO_DSN=root:password@tcp(127.0.0.1:3306)/kabao?charset=utf8mb4&parseTime=True&loc=Local

# Optional: used in scheduler heartbeat payloads for easier source identification
KABAO_SERVICE_NAME=merchant_service

# Scheduler health threshold, in minutes
KABAO_SCHEDULER_HEALTH_STALE_MINUTES=3

# Webhook alerts
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=replace-me
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/replace-me

# Existing security-related env vars should still be configured in real deployment
KABAO_JWT_SECRET=replace-me
KABAO_USER_JWT_SECRET=replace-me
KABAO_USER_CODE_SECRET=replace-me
PLATFORM_ADMIN_TOKEN=replace-me
